model Model
	culture: pl-PL
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pl-PL
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_date","dim_location","dim_team","fact_air_quality","fact_housing_price","fact_match","fact_wage","fact_weather_daily","mart_city_score","mart_match_weather","dim_market_option"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_date
ref table dim_location
ref table dim_team
ref table fact_air_quality
ref table fact_housing_price
ref table fact_match
ref table fact_wage
ref table fact_weather_daily
ref table mart_city_score
ref table mart_match_weather
ref table dim_market_option

ref cultureInfo pl-PL

