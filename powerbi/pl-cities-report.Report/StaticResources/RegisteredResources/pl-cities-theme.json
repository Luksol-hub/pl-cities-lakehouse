{
  "name": "pl-cities",
  "dataColors": [
    "#1F5A99",
    "#4A7FB5",
    "#8DB3DA",
    "#12355B",
    "#6F9CC9",
    "#B8D2EC",
    "#2E7DBF",
    "#5E7C99"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#1F5A99",
  "good": "#1F5A99",
  "neutral": "#8DB3DA",
  "bad": "#C2410C",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1F2937"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1F2937"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#334155"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#1F5A99"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCE3EC"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#12355B"
              }
            },
            "position": "Outer",
            "preset": "BottomRight",
            "transparency": 88
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 10,
            "right": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF2F7"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#EEF2F7"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "advancedSlicerVisual": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "shapeCustomRectangle": [
          {
            "$id": "default",
            "tileShape": "rectangleRoundedByPixel",
            "rectangleRoundedCurve": 10
          }
        ],
        "fillCustom": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          },
          {
            "$id": "interaction:hover",
            "fillColor": {
              "solid": {
                "color": "#EEF4FB"
              }
            }
          },
          {
            "$id": "selection:selected",
            "fillColor": {
              "solid": {
                "color": "#1F5A99"
              }
            }
          }
        ],
        "value": [
          {
            "$id": "default",
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#12355B"
              }
            },
            "fontSize": 10,
            "bold": true
          },
          {
            "$id": "selection:selected",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#DCE3EC"
              }
            },
            "weight": 1
          }
        ],
        "shadowCustom": [
          {
            "$id": "default",
            "show": true,
            "color": {
              "solid": {
                "color": "#12355B"
              }
            },
            "transparency": 88,
            "preset": "BottomRight"
          }
        ]
      }
    }
  }
}